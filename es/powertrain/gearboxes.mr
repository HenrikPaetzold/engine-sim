module {
    @name:      "Gearbox Library"
}

private import "../types/atomic_types.mr"
private import "../types/conversions.mr"
private import "../types/operations.mr"
private import "../constants/units.mr"
private import "../objects/objects.mr"
private import "powertrain.mr"

units units()

private node gearbox_base {
    input max_clutch_torque [float]: 1000 * units.lb_ft;
    input type [string]: "legacy";
    input turbine_inertia [float]: 0.08;
    input stall_torque_ratio [float]: 2.0;
    input coupling_point [float]: 0.85;
    input capacity_factor [float]: 0.00404;
    input reverse_ratio [float]: 3.2;
    input park_lock_torque [float]: 4000 * units.Nm;

    alias output __out [transmission_channel]:
        transmission(
            max_clutch_torque: max_clutch_torque,
            type: type,
            turbine_inertia: turbine_inertia,
            stall_torque_ratio: stall_torque_ratio,
            coupling_point: coupling_point,
            capacity_factor: capacity_factor,
            reverse_ratio: reverse_ratio,
            park_lock_torque: park_lock_torque);
}

public node manual_gearbox {
    input max_clutch_torque [float]: 1000 * units.lb_ft;
    input reverse_ratio [float]: 3.2;
    input park_lock_torque [float]: 4000 * units.Nm;

    alias output __out [transmission_channel]:
        gearbox_base(type: "manual", max_clutch_torque: max_clutch_torque, reverse_ratio: reverse_ratio, park_lock_torque: park_lock_torque);
}

public node robotised_manual_gearbox {
    input max_clutch_torque [float]: 1000 * units.lb_ft;
    input reverse_ratio [float]: 3.2;
    input park_lock_torque [float]: 4000 * units.Nm;

    alias output __out [transmission_channel]:
        gearbox_base(type: "amt", max_clutch_torque: max_clutch_torque, reverse_ratio: reverse_ratio, park_lock_torque: park_lock_torque);
}

public node dual_clutch_gearbox {
    input max_clutch_torque [float]: 1000 * units.lb_ft;
    input reverse_ratio [float]: 3.2;
    input park_lock_torque [float]: 4000 * units.Nm;

    alias output __out [transmission_channel]:
        gearbox_base(type: "dct", max_clutch_torque: max_clutch_torque, reverse_ratio: reverse_ratio, park_lock_torque: park_lock_torque);
}

public node converter_gearbox {
    input max_clutch_torque [float]: 1000 * units.lb_ft;
    input reverse_ratio [float]: 3.2;
    input park_lock_torque [float]: 4000 * units.Nm;
    input turbine_inertia [float]: 0.08;
    input stall_torque_ratio [float]: 2.0;
    input coupling_point [float]: 0.85;
    input capacity_factor [float]: 0.00404;

    alias output __out [transmission_channel]:
        gearbox_base(
            type: "converter",
            max_clutch_torque: max_clutch_torque,
            turbine_inertia: turbine_inertia,
            stall_torque_ratio: stall_torque_ratio,
            coupling_point: coupling_point,
            capacity_factor: capacity_factor,
            reverse_ratio: reverse_ratio,
            park_lock_torque: park_lock_torque);
}

public node manual_control {
    input final_drive [float]: 3.42;
    input tire_radius [float]: 12 * units.inch;
    input default_position [string]: "N";

    alias output __out [tcu_channel]:
        transmission_control_unit(
            final_drive: final_drive,
            tire_radius: tire_radius,
            torque_interrupt: true,
            driver_clutch: true,
            default_position: default_position);
}

public node robotised_manual_control {
    input final_drive [float]: 3.42;
    input tire_radius [float]: 12 * units.inch;
    input torque_cut [float]: 1.00;
    input torque_reduction [float]: 0.70;
    input speed_match_time [float]: 0.30 * units.sec;
    input speed_match_tolerance [float]: 120 * units.rpm;
    input min_gear_time [float]: 0.60 * units.sec;
    input default_position [string]: "N";

    alias output __out [tcu_channel]:
        transmission_control_unit(
            final_drive: final_drive,
            tire_radius: tire_radius,
            torque_interrupt: true,
            torque_cut: torque_cut,
            torque_reduction: torque_reduction,
            speed_match_time: speed_match_time,
            speed_match_tolerance: speed_match_tolerance,
            min_gear_time: min_gear_time,
            default_position: default_position);
}

public node dual_clutch_control {
    input final_drive [float]: 3.42;
    input tire_radius [float]: 12 * units.inch;
    input clutch_overlap_time [float]: 0.16 * units.sec;
    input overlap_hold [float]: 0.20;
    input multi_via_intermediate [bool]: false;
    input multi_max_gears [float]: 2;
    input torque_reduction [float]: 0.80;
    input torque_cut [float]: 1.00;
    input min_gear_time [float]: 0.35 * units.sec;
    input default_position [string]: "N";

    alias output __out [tcu_channel]:
        transmission_control_unit(
            final_drive: final_drive,
            tire_radius: tire_radius,
            torque_interrupt: false,
            preselect: true,
            clutch_overlap_time: clutch_overlap_time,
            overlap_hold: overlap_hold,
            multi_via_intermediate: multi_via_intermediate,
            multi_max_gears: multi_max_gears,
            torque_reduction: torque_reduction,
            torque_cut: torque_cut,
            min_gear_time: min_gear_time,
            default_position: default_position);
}

public node converter_control {
    input final_drive [float]: 3.42;
    input tire_radius [float]: 12 * units.inch;
    input clutch_overlap_time [float]: 0.25 * units.sec;
    input overlap_hold [float]: 0.25;
    input torque_reduction [float]: 0.85;
    input lockup_slip_target [float]: 120 * units.rpm;
    input lockup_lock_slip [float]: 25 * units.rpm;
    input lockup_apply_rate [float]: 1.5;
    input launch_slip_target [float]: 1000 * units.rpm;
    input kickdown_threshold [float]: 0.85;
    input min_gear_time [float]: 0.60 * units.sec;
    input default_position [string]: "N";

    alias output __out [tcu_channel]:
        transmission_control_unit(
            final_drive: final_drive,
            tire_radius: tire_radius,
            torque_interrupt: false,
            launch_device: true,
            clutch_overlap_time: clutch_overlap_time,
            overlap_hold: overlap_hold,
            torque_reduction: torque_reduction,
            lockup_slip_target: lockup_slip_target,
            lockup_lock_slip: lockup_lock_slip,
            lockup_apply_rate: lockup_apply_rate,
            launch_slip_target: launch_slip_target,
            kickdown_threshold: kickdown_threshold,
            min_gear_time: min_gear_time,
            default_position: default_position);
}
