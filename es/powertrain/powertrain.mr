module {
    @name:      "Powertrain Control"
}

private import "../types/atomic_types.mr"
private import "../types/conversions.mr"
private import "../types/operations.mr"
private import "../constants/units.mr"

units units()

// Channels

public node pid_controller_channel => __engine_sim__pid_controller_channel { /* void */ }
public node map_2d_channel => __engine_sim__map_2d_channel { /* void */ }
public node drive_mode_channel => __engine_sim__drive_mode_channel { /* void */ }
public node ecu_channel => __engine_sim__ecu_channel { /* void */ }
public node tcu_channel => __engine_sim__tcu_channel { /* void */ }
public node adaptation_channel => __engine_sim__adaptation_channel { /* void */ }
public node gate_position_channel => __engine_sim__gate_position_channel { /* void */ }

// Objects

public node pid_controller => __engine_sim__pid_controller {
    input kp [float]: 0.0;
    input ki [float]: 0.0;
    input kd [float]: 0.0;
    input min [float]: 0.0;
    input max [float]: 1.0;
    input d_filter_hz [float]: 0.0;
    input anti_windup [float]: 1.0;
    input integrator_limit [float]: 1000000.0;
    alias output __out [pid_controller_channel];
}

public node map_2d => __engine_sim__map_2d {
    alias output __out [map_2d_channel];
}

public node drive_mode => __engine_sim__drive_mode {
    input name [string]: "mode";
    alias output __out [drive_mode_channel];
}

public node engine_control_unit => __engine_sim__engine_control_unit {
    input reference_torque [float]: 200 * units.Nm;
    input torque_rise_rate [float]: 2000 * units.Nm;
    input torque_fall_rate [float]: 4000 * units.Nm;
    input idle_speed_cold [float]: 1300 * units.rpm;
    input idle_speed_warm [float]: 800 * units.rpm;
    input cold_temperature [float]: (-10.0 + units.K0);
    input warm_temperature [float]: (80.0 + units.K0);
    input cold_start_enrichment [float]: 1.6;
    input cold_start_timing_retard [float]: 8 * units.deg;
    input cold_start_torque_cap [float]: 0.6;
    input rev_limit [float]: 7000 * units.rpm;
    input rev_limit_cold [float]: 7000 * units.rpm;
    input soft_limit_band [float]: 300 * units.rpm;
    input hard_limit_offset [float]: 150 * units.rpm;
    input overrun_cut_speed [float]: 2000 * units.rpm;
    input overrun_resume_speed [float]: 1400 * units.rpm;
    input cranking_speed [float]: 400 * units.rpm;

    input idle_controller [pid_controller_channel]: pid_controller(kp: 0.004, ki: 0.02, min: 0.0, max: 1.0);
    input torque_controller [pid_controller_channel]: pid_controller(kp: 0.0008, ki: 0.004, min: -0.35, max: 0.35);
    input throttle_map [map_2d_channel]: map_2d();
    input max_torque_map [map_2d_channel]: map_2d();
    input pedal_map [map_2d_channel]: map_2d();

    alias output __out [ecu_channel];
}

public node transmission_control_unit => __engine_sim__transmission_control_unit {
    input final_drive [float]: 3.42;
    input tire_radius [float]: 12 * units.inch;
    input torque_interrupt [bool]: true;
    input preselect [bool]: false;
    input launch_device [bool]: false;
    input driver_clutch [bool]: false;
    input torque_reduction [float]: 0.70;
    input torque_cut [float]: 1.00;
    input overlap_hold [float]: 0.15;
    input multi_via_intermediate [bool]: false;
    input multi_max_gears [float]: 2;
    input speed_match_tolerance [float]: 120 * units.rpm;
    input lockup_slip_target [float]: 120 * units.rpm;
    input lockup_lock_slip [float]: 25 * units.rpm;
    input lockup_apply_rate [float]: 1.5;
    input torque_reduction_time [float]: 0.08 * units.sec;
    input clutch_release_time [float]: 0.10 * units.sec;
    input gear_change_time [float]: 0.06 * units.sec;
    input speed_match_time [float]: 0.25 * units.sec;
    input clutch_overlap_time [float]: 0.18 * units.sec;
    input clutch_engage_time [float]: 0.30 * units.sec;
    input min_gear_time [float]: 0.80 * units.sec;
    input kickdown_threshold [float]: 0.85;
    input kickdown_pedal_rate [float]: 0.0;
    input kickdown_pedal_floor [float]: 0.25;
    input kickdown_filter [float]: 0.08 * units.sec;
    input kickdown_rev_margin [float]: 500 * units.rpm;
    input kickdown_target_speed [float]: 6200 * units.rpm;
    input launch_slip_target [float]: 1000 * units.rpm;
    input launch_lock_slip [float]: 60 * units.rpm;
    input stall_protect_speed [float]: 650 * units.rpm;
    input brake_interlock [bool]: true;
    input default_position [string]: "N";

    input slip_controller [pid_controller_channel]: pid_controller(kp: 0.004, ki: 0.9, min: 0.0, max: 1.0);
    input upshift_map [map_2d_channel]: map_2d();
    input downshift_map [map_2d_channel]: map_2d();
    input lockup_map [map_2d_channel]: map_2d();
    input kickdown_map [map_2d_channel]: map_2d();
    input intermediate_bias [map_2d_channel]: map_2d();
    input overlap_shape [map_2d_channel]: map_2d();
    input engage_shape [map_2d_channel]: map_2d();
    input lockup_controller [pid_controller_channel]: pid_controller(kp: 0.004, ki: 0.9, min: 0.0, max: 1.0);

    alias output __out [tcu_channel];
}

public node adaptation => __engine_sim__adaptation {
    input throttle_map [bool]: true;
    input idle [bool]: true;
    input lambda [bool]: true;
    input shift [bool]: true;
    input throttle_rate [float]: 0.5;
    input throttle_deadband [float]: 0.01;
    input idle_drain_rate [float]: 0.6;
    input idle_limit [float]: 0.35;
    input lambda_gain [float]: 0.8;
    input lambda_limit [float]: 0.30;
    input lambda_target [float]: 0.02;
    input warm_temperature [float]: (70.0 + units.K0);
    input speed_window [float]: 120 * units.rpm;

    alias output __out [adaptation_channel];
}

// Actions

private node _add_gear_ratio => __engine_sim__add_gear_ratio {
    input ratio [float];
    input tcu [tcu_channel];
}

public node add_gear_ratio {
    input ratio;
    input this;
    alias output __out: this;

    _add_gear_ratio(ratio, this)
}

private node _add_map_sample => __engine_sim__add_map_sample {
    input x [float];
    input y [float];
    input value [float];
    input map [map_2d_channel];
}

public node add_map_sample {
    input x;
    input y: 0.0;
    input value;
    input this;
    alias output __out: this;

    _add_map_sample(x: x, y: y, value: value, map: this)
}

private node _set_drive_mode_value => __engine_sim__set_drive_mode_value {
    input path [string];
    input value [float];
    input mode [drive_mode_channel];
}

public node set {
    input path;
    input value;
    input this;
    alias output __out: this;

    _set_drive_mode_value(path: path, value: value, mode: this)
}

private node _set_drive_mode_map => __engine_sim__set_drive_mode_map {
    input path [string];
    input map [map_2d_channel];
    input mode [drive_mode_channel];
}

public node set_map {
    input path;
    input map;
    input this;
    alias output __out: this;

    _set_drive_mode_map(path: path, map: map, mode: this)
}

public node add_drive_mode => __engine_sim__add_drive_mode {
    input mode [drive_mode_channel];
}

public node gate_position => __engine_sim__gate_position {
    input name [string]: "N";
    input engagement [string]: "neutral";
    input max_entry_speed [float]: -1.0;
    input max_exit_speed [float]: -1.0;
    input requires_brake [bool]: false;
    input mode [string]: "";

    alias output __out [gate_position_channel];
}

private node _add_gate_position => __engine_sim__add_gate_position {
    input position [gate_position_channel];
    input tcu [tcu_channel];
}

public node add_gate_position {
    input position;
    input this;
    alias output __out: this;

    _add_gate_position(position: position, tcu: this)
}

public node automatic_gate {
    input this;
    alias output __out: this;

    _add_gate_position(
        position: gate_position(
            name: "P", engagement: "park",
            max_entry_speed: 0.3, max_exit_speed: 0.3, requires_brake: true),
        tcu: this)
    _add_gate_position(
        position: gate_position(name: "R", engagement: "reverse", max_entry_speed: 1.0),
        tcu: this)
    _add_gate_position(
        position: gate_position(name: "N", engagement: "neutral"),
        tcu: this)
    _add_gate_position(
        position: gate_position(name: "D", engagement: "forward"),
        tcu: this)
}

public node set_parameter => __engine_sim__set_parameter {
    input path [string];
    input value [float];
}

public node set_map_cell => __engine_sim__set_map_cell {
    input path [string];
    input x [float];
    input y [float]: 0.0;
    input value [float];
}

public node set_powertrain => __engine_sim__set_powertrain {
    input ecu [ecu_channel]: engine_control_unit();
    input tcu [tcu_channel]: transmission_control_unit();
    input adaptation [adaptation_channel]: adaptation();
    input default_mode [string]: "";
}
